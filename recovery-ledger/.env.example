POLAR_CLIENT_ID=your-client-id-here
POLAR_CLIENT_SECRET=your-client-secret-here
POLAR_REDIRECT_URI=https://polar-flow-but-better.onrender.com/oauth/callback
DATABASE_URL=postgresql://user:password@host:5432/recovery_ledger

# Strongly recommended on a public Render URL.
APP_USERNAME=your-private-username
APP_PASSWORD=your-long-random-password

# Optional. Only enable briefly when debugging raw Polar payloads.
ENABLE_DEBUG_RAW=0
